# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/apex_db"

# Authentication secret & application URL
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email configuration
EMAIL_FROM="Project Apex <no-reply@apex.local>"
