# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/apex_db"

# Authentication secret & application URL
BETTER_AUTH_SECRET="your-32-character-random-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Transactional Email configuration
EMAIL_FROM="Project Apex <no-reply@apex.local>"
# Optional: Production SMTP or Resend credentials
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Razorpay Payment Gateway (Test Mode / Production)
# Obtain your test keys from Razorpay Dashboard: Settings > API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key_here"
# Optional: Webhook secret for automated signature verification
# RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"

# Firebase Client SDK Configuration (Console > Project Settings > General > Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-app-id-default-rtdb.firebaseio.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Firebase Admin SDK Configuration (Console > Project Settings > Service Accounts)
# FIREBASE_PROJECT_ID="your-app-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-app-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
