datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  phoneNumber   String?
  phoneVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  addresses      Address[]
  securityEvents SecurityEvent[]
  orders         Order[]
  reviews        Review[]
  helpfulVotes   ReviewHelpfulVote[]
  reviewReports  ReviewReport[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  street       String
  city         String
  state        String
  zipCode      String
  country      String   @default("United States")
  phone        String?
  isDefault    Boolean  @default(false)
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("address")
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("security_event")
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String         @default("CONFIRMED") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentStatus     String         @default("PAID")      // PENDING, PAID, FAILED, REFUNDED
  currency          String         @default("USD")
  subtotal          Float
  shipping          Float          @default(0)
  tax               Float          @default(0)
  discount          Float          @default(0)
  total             Float
  deliveryMethod    String         @default("FREE_STANDARD")
  estimatedDelivery String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  items             OrderItem[]
  addressSnapshot   OrderAddress?
  payment           Payment?

  @@index([userId])
  @@index([orderNumber])
  @@map("order")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productTitle String
  productImage String
  unitPrice    Float
  quantity     Int
  lineTotal    Float

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model OrderAddress {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fullName     String
  street       String
  city         String
  state        String
  zipCode      String
  country      String   @default("United States")
  phone        String?
  instructions String?

  @@map("order_address")
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   // "SIMULATED_CARD", "CASH_ON_DELIVERY", "APEX_POINTS"
  providerReference String
  amount            Float
  currency          String   @default("USD")
  status            String   @default("PAID") // PENDING, PAID, FAILED, REFUNDED
  cardLast4         String?
  cardBrand         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("payment")
}

model ProductInventory {
  productId   String   @id
  stock       Int      @default(100)
  reserved    Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("product_inventory")
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  orderId   String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([key])
  @@index([userId])
  @@map("idempotency_record")
}

enum ReviewStatus {
  PUBLISHED
  PENDING
  HIDDEN
}

model Review {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  orderItemId      String?
  rating           Int          // 1 through 5
  title            String       @db.VarChar(120)
  body             String       @db.VarChar(5000)
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PUBLISHED)
  helpfulCount     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  helpfulVotes     ReviewHelpfulVote[]
  reports          ReviewReport[]

  @@unique([userId, productId])
  @@index([productId, status, createdAt])
  @@index([userId, createdAt])
  @@map("review")
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@map("review_helpful_vote")
}

model ReviewReport {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  details   String?
  status    String   @default("PENDING") // PENDING, REVIEWED, DISMISSED
  createdAt DateTime @default(now())

  @@index([reviewId])
  @@map("review_report")
}


